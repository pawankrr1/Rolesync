# Career Intelligence Backend Environment Configuration
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Career Intelligence API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENABLE_DOCS=false

# Security & Secrets (Required min 32 chars in production)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-token-32-chars-min

# Binding & Concurrency
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=4

# Explicit Production Origins (No wildcard '*' allowed in production)
CORS_ORIGINS=https://careerintel.example.com

# Production Database (PostgreSQL)
DATABASE_URL=postgresql://career_admin:your_secure_db_password@localhost:5432/career_intelligence
