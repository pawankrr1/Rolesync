# ==============================================================================
# Career Intelligence Platform - Environment Configuration Template
# Build for Bharat 2.0
#
# Instructions:
# 1. Copy this file to .env (or .env.production)
# 2. In production, ensure ENVIRONMENT=production, DEBUG=false, and supply a strong SECRET_KEY.
# 3. NEVER commit real secrets or .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode Controls
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=production

# Debug Mode: MUST be 'false' in production. Setting to true will fail pre-flight validation.
DEBUG=false

# Service Identity
PROJECT_NAME="Career Intelligence API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Enable Swagger/OpenAPI docs in production (default false for security)
ENABLE_DOCS=false

# ------------------------------------------------------------------------------
# 2. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Minimum 32-character high-entropy secret string.
# Generate via: openssl rand -hex 32
SECRET_KEY=change-this-to-a-cryptographically-secure-random-token-32-chars-min

# ------------------------------------------------------------------------------
# 3. Server & Network Binding
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Frontend Binding
PORT=3000
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# In production: MUST be comma-separated list of explicit allowed origin URLs.
# Wildcard '*' is strictly forbidden in production.
CORS_ORIGINS=https://careerintel.example.com,https://app.careerintel.example.com

# ------------------------------------------------------------------------------
# 5. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (SQLite):
# DATABASE_URL=sqlite:///./career_intelligence.db

# Production Relational Database (PostgreSQL):
DATABASE_URL=postgresql://career_admin:your_secure_db_password@localhost:5432/career_intelligence

# If using docker-compose.production.yml with internal db service:
# DATABASE_URL=postgresql://career_admin:your_secure_db_password@db:5432/career_intelligence

# PostgreSQL Credentials (for docker-compose.production.yml)
POSTGRES_DB=career_intelligence
POSTGRES_USER=career_admin
POSTGRES_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# 6. Frontend API Gateway Configuration
# ------------------------------------------------------------------------------
# URL consumed by the client browser / Next.js to reach the FastAPI backend:
NEXT_PUBLIC_API_URL=https://api.careerintel.example.com

# ------------------------------------------------------------------------------
# 7. Seed & Demo Data Controls
# ------------------------------------------------------------------------------
# In production, ONLY canonical reference data (skills, roles, courses) is seeded.
# To force synthetic demo candidates and mock job postings (e.g. for staging demos):
# CONFIRM_PRODUCTION_DEMO_SEED=false
